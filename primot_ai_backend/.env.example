# Primot AI Backend Environment Configuration

# Application settings
APP_NAME="Primot AI Backend"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Firebase Project Configuration
# Reusing the existing Primot Firebase Project ID
FIREBASE_PROJECT_ID="company-erp-19499"

# Path to service account JSON file (optional if using GOOGLE_APPLICATION_CREDENTIALS)
# e.g., serviceAccountKey.json placed securely outside of version control
FIREBASE_CREDENTIALS_PATH=""

# Allowed CORS origins (comma-separated, or * for all during development)
CORS_ORIGINS="*"

