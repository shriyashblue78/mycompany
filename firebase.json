{
  "storage": {"rules": "storage.rules"},
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"],
      "predeploy": ["npm --prefix functions run lint", "npm --prefix functions run build"]
    }
  ],
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/downloads/**/*.apk",
        "headers": [
          {"key": "Content-Type", "value": "application/vnd.android.package-archive"},
          {"key": "Content-Disposition", "value": "attachment"},
          {"key": "Cache-Control", "value": "public, max-age=3600"}
        ]
      },
      {
        "source": "/apk_config.json",
        "headers": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Cache-Control", "value": "public, max-age=300"}
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "company-erp-19499",
          "appId": "1:224128098759:android:7235aab37743d6c4fb79e2",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "company-erp-19499",
          "configurations": {
            "android": "1:224128098759:android:7235aab37743d6c4fb79e2",
            "ios": "1:224128098759:ios:17533cdaacaf09f0fb79e2",
            "web": "1:224128098759:web:815883a3a984bbd1fb79e2",
            "windows": "1:224128098759:web:b3e32b210038b0d1fb79e2"
          }
        }
      }
    }
  }
}